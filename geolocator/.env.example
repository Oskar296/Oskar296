# Copy this file to `.env` and put your key in it:
#
#     cp .env.example .env
#
# Get a key from https://console.anthropic.com/settings/keys
#
# `.env` is gitignored. Never commit a real key, and never paste one into a
# chat, an issue, or a screenshot. If one leaks, revoke it in the console.

ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. Use claude-sonnet-5 for lower cost.
# GEOLOCATOR_MODEL=claude-opus-5
